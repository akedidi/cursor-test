import java.util.Properties
import java.math.BigInteger

def filePath = 'C:/jmeter-data/policy.properties'
def file = new File(filePath)
def propsFile = new Properties()

def lock = props.get('POLICY_FILE_LOCK')
if (lock == null) {
    synchronized (this.class) {
        lock = props.get('POLICY_FILE_LOCK')
        if (lock == null) {
            lock = new Object()
            props.put('POLICY_FILE_LOCK', lock)
        }
    }
}

synchronized (lock) {
    // Initialisation / lecture
    if (file.exists()) {
        file.withInputStream { propsFile.load(it) }
    } else {
        file.parentFile?.mkdirs()
        propsFile.setProperty('policy_number_bns', '05.0202025618001500')
        file.withOutputStream { os -> propsFile.store(os, 'policy') }
    }

    def policy = propsFile.getProperty('policy_number_bns')
    if (!policy) {
        throw new Exception("policy_number_bns absent du fichier")
    }

    // Validation stricte du format : 2 chiffres . 16 chiffres
    if (!(policy ==~ /^\d{2}\.\d{16}$/)) {
        throw new Exception("Format invalide pour policy_number_bns: ${policy} (attendu: 2 chiffres, point, 16 chiffres)")
    }

    def parts = policy.split('\\.')
    def leftPart = parts[0]          // ex: 05
    def rightPart = parts[1]         // ex: 0202025618001509

    def originalLength = 16
    def incremented = (new BigInteger(rightPart) + BigInteger.ONE).toString()

    // Refuser tout dépassement de 16 chiffres
    if (incremented.length() > originalLength) {
        throw new Exception("Overflow policy_number_bns: impossible d'incrémenter ${policy} sans dépasser 16 chiffres après le point")
    }

    def newRightPart = incremented.padLeft(originalLength, '0')
    def newPolicy = leftPart + '.' + newRightPart

    // Valeur utilisée par Sale puis Cancellation
    vars.put('policy_number_bns', newPolicy)

    // Persistance disque
    propsFile.setProperty('policy_number_bns', newPolicy)
    file.withOutputStream { os -> propsFile.store(os, 'policy') }

    log.info("Generated policy_number_bns = ${newPolicy}")
}
