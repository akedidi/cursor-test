import java.util.Properties

def filePath = 'C:/jmeter-data/policy.properties'
def lockName = 'POLICY_FILE_LOCK'

// verrou global JMeter partagé entre threads
def lock = props.get(lockName)
if (lock == null) {
    synchronized (this.class) {
        lock = props.get(lockName)
        if (lock == null) {
            lock = new Object()
            props.put(lockName, lock)
        }
    }
}

synchronized (lock) {
    def file = new File(filePath)
    def propsFile = new Properties()

    // initialisation si le fichier n'existe pas
    if (!file.exists()) {
        file.parentFile?.mkdirs()
        propsFile.setProperty('policy_number_bns', '05.0202025618001500')
        file.withOutputStream { os ->
            propsFile.store(os, 'JMeter policy number')
        }
    }

    // lecture
    file.withInputStream { input ->
        propsFile.load(input)
    }

    def policy = propsFile.getProperty('policy_number_bns')
    if (!policy) {
        throw new Exception("La clé policy_number_bns est absente du fichier")
    }

    // extrait toute la partie numérique finale
    def matcher = (policy =~ /(\d+)$/)
    if (!matcher.find()) {
        throw new Exception("Aucune partie numérique finale trouvée dans : " + policy)
    }

    def suffix = matcher.group(1)
    def prefix = policy.substring(0, policy.length() - suffix.length())

    // incrément réel avec retenue
    def newSuffix = (suffix.toLong() + 1).toString().padStart(suffix.length(), '0')
    def newPolicy = prefix + newSuffix

    // variable JMeter pour usage immédiat
    vars.put('policy_number_bns', newPolicy)

    // persistance disque
    propsFile.setProperty('policy_number_bns', newPolicy)
    file.withOutputStream { os ->
        propsFile.store(os, 'JMeter policy number')
    }

    log.info("policy_number_bns saved = ${newPolicy}")
}
